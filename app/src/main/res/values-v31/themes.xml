<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/toxifiles_canvas</item>
        <item name="android:navigationBarColor">@color/toxifiles_canvas</item>
        <item name="android:colorAccent">@color/toxifiles_signal</item>
        <item name="android:windowBackground">@color/toxifiles_canvas</item>
        <item name="android:windowSplashScreenBackground">@color/toxifiles_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_toxifiles_brand_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#142435</item>
        <item name="android:windowSplashScreenAnimationDuration">240</item>
        <item name="android:alertDialogTheme">@style/ToxiDialogTheme</item>
    </style>
    <style name="AppTheme_Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#F3F6FA</item>
        <item name="android:navigationBarColor">#F3F6FA</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#347B67</item>
        <item name="android:windowBackground">#F3F6FA</item>
        <item name="android:windowSplashScreenBackground">#F3F6FA</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_toxifiles_brand_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#E3EEE9</item>
        <item name="android:windowSplashScreenAnimationDuration">240</item>
        <item name="android:alertDialogTheme">@style/ToxiDialogTheme_Light</item>
    </style>
</resources>