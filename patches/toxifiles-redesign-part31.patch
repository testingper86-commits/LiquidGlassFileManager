+                .setNeutralButton("Skip existing", (dialog, which) -> FileOps.paste(a, src, destination, move, true, done))
+                .setPositiveButton("Keep both", (dialog, which) -> FileOps.paste(a, src, destination, move, false, done))
+                .show();
+    }
